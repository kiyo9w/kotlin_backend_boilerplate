# the service server — production example.
#
# Copy to `.env` on the host (gitignored) and fill every value from the host's
# secret store. Same key set as `.env.example`; `ConfigExampleTest` enforces
# that. No real credential belongs in this file or any committed file.
#
# Production reaches this process through the host's secret manager or
# environment, never through a committed file. See `docs/backend/` for the
# deploy target once it lands.

# Durable Postgres. Required in production; a blank URL is the local-only
# memory mode and is wrong for a real deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/qoloa

# Model gateway. The key is injected from the host secret store. Never commit it.
CMD_API_KEY=
XAI_API_KEY=
CMD_BASE=https://api.commandcode.ai/provider/v1
CMD_MODEL=meta/muse-spark-1.2-contributor

# Per-device daily caps. Set real numbers in production; <= 0 is uncapped.
QOLOA_DAILY_SEED_CAP=24
QOLOA_DAILY_TALK_CAP=120

# Leave blank in production. Set only for a deliberate maintenance window.
QOLOA_FACTORY_KILL=

# Keep false in production. `true` trusts structural store payloads without a
# signature check and is never a production posture.
QOLOA_STORE_EVENTS_TRUST_UNVERIFIED=false

# Apple root CA for App Store JWS verification. Provide the PEM inline or a
# path to a PEM file mounted read-only on the host.
QOLOA_APPLE_ROOT_CA_PEM=
QOLOA_APPLE_ROOT_CA_PATH=
