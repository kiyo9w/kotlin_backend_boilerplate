# Values for deploy/docker-compose.yml. Copy to deploy/.env (gitignored).
# No production credential belongs in a committed file.

POSTGRES_USER=qoloa
POSTGRES_PASSWORD=change-me-before-first-deploy
POSTGRES_DB=qoloa

# Loopback port the server binds behind nginx.
SERVER_PORT=8081

# Model gateway. Blank disables generated routes; the authored pack still serves.
CMD_API_KEY=
CMD_BASE=https://api.commandcode.ai/provider/v1
CMD_MODEL=meta/muse-spark-1.2-contributor

# Daily caps per device. <= 0 means uncapped.
QOLOA_DAILY_SEED_CAP=24
QOLOA_DAILY_TALK_CAP=120

# Maintenance kill switch and store-webhook trust. Both stay at their safe
# production values.
QOLOA_FACTORY_KILL=
QOLOA_STORE_EVENTS_TRUST_UNVERIFIED=false

# Apple root CA for App Store JWS verification: inline PEM or a read-only path.
QOLOA_APPLE_ROOT_CA_PEM=
QOLOA_APPLE_ROOT_CA_PATH=
