# the service server — local / first-hour example.
#
# Copy to `.env` (gitignored) and fill what you need. Every key here is bound by
# `core/ServerConfig.kt`; `ConfigExampleTest` fails if this file and
# `.env.production.example` drift from that list.
#
# No real credential belongs in this file or any committed file.

# Durable Postgres. Leave blank for the explicit local-only memory mode
# (in-process ledger, counts die with the process, no migrations run).
DATABASE_URL=

# Model gateway. Any OpenAI-compatible endpoint works. The key stays on the
# server and out of the client build. Blank disables model routes; the authored
# pack still serves (ADR-003 circuit breaker).
CMD_API_KEY=
# Accepted alias for CMD_API_KEY, for xAI-compatible setups.
XAI_API_KEY=
CMD_BASE=https://api.commandcode.ai/provider/v1
CMD_MODEL=meta/muse-spark-1.2-contributor

# Per-device daily caps. Blank or a value <= 0 means uncapped.
QOLOA_DAILY_SEED_CAP=24
QOLOA_DAILY_TALK_CAP=120

# Global model-route kill switch (1, true, or yes). Readers keep the authored
# pack while generated routes answer 503.
QOLOA_FACTORY_KILL=

# Store webhook trust. Leave false so an unverifiable webhook is refused and
# recorded, never trusted. `true` (1, true, yes) accepts structural payloads
# and is a local-testing affordance only.
QOLOA_STORE_EVENTS_TRUST_UNVERIFIED=

# Apple root CA for App Store JWS verification. Provide the PEM inline or a
# path to a PEM file. With neither, verification is unavailable and the route
# records the raw event without granting entitlement (ADR-0015).
QOLOA_APPLE_ROOT_CA_PEM=
QOLOA_APPLE_ROOT_CA_PATH=
